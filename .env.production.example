# DNS A/AAAA kaydi bu sunucuyu gosteren gercek alan adi
LUNA_DOMAIN=luna.example.com

# ACME sertifika bildirimleri icin e-posta
ACME_EMAIL=you@example.com

# Yalniz sunucunun kendi localhost arayuzunde acilan tanilama portu
LUNA_PORT=8080

# Oturum suresi (1-365 gun)
PERIOD_TRACKER_SESSION_DAYS=30
