# DNS A/AAAA kaydi bu sunucuyu gosteren gercek alan adi
LUNA_DOMAIN=luna.example.com

# ACME sertifika bildirimleri icin e-posta
ACME_EMAIL=you@example.com

# Yalniz sunucunun kendi localhost arayuzunde acilan tanilama portu
LUNA_PORT=8080

# Oturum suresi (1-365 gun)
PERIOD_TRACKER_SESSION_DAYS=30

# Auth rate limitleri: izin verilen başarısız deneme ve pencere süresi (saniye)
PERIOD_TRACKER_LOGIN_ATTEMPTS=5
PERIOD_TRACKER_LOGIN_WINDOW_SECONDS=900
PERIOD_TRACKER_RECOVERY_ATTEMPTS=5
PERIOD_TRACKER_RECOVERY_WINDOW_SECONDS=1800
PERIOD_TRACKER_REGISTER_ATTEMPTS=10
PERIOD_TRACKER_REGISTER_WINDOW_SECONDS=3600

# Şifreli backup anahtarı ayrı, Git-ignored .env.backup dosyasında tutulur.
# Bu dosyada yalnız zamanlama/saklama politikası bulunur.
PERIOD_TRACKER_BACKUP_INTERVAL_HOURS=24
PERIOD_TRACKER_BACKUP_RETENTION_DAYS=30
PERIOD_TRACKER_BACKUP_MIN_FILES=3
